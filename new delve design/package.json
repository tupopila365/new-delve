{
  "name": "@delve/traveler-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "vite --host 0.0.0.0",
    "dev:traveler": "pnpm --filter @delve/traveler-web dev",
    "dev:admin": "pnpm --filter @delve/admin-web dev",
    "dev:api": "pnpm --filter @delve/api dev",
    "build": "vite build",
    "build:appwrite": "node scripts/appwrite-site-build.mjs",
    "build:traveler": "pnpm run build",
    "build:all": "pnpm --filter @delve/contracts --filter @delve/config --filter @delve/database --filter @delve/api --filter @delve/admin-web run build && pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:all": "pnpm --filter @delve/contracts --filter @delve/config --filter @delve/database --filter @delve/api --filter @delve/admin-web run typecheck && pnpm run typecheck",
    "db:generate": "pnpm --filter @delve/database generate",
    "db:migrate": "pnpm --filter @delve/database migrate",
    "admin:create": "pnpm --filter @delve/api admin:create",
    "appwrite:setup-profile": "node scripts/appwrite-setup-traveler-profile.mjs",
    "preview": "vite preview",
    "start": "node scripts/heroku-web.mjs",
    "heroku-postbuild": "node scripts/heroku-postbuild.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "@delve/contracts": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "appwrite": "^26.2.0",
    "lucide-react": "^1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "serve": "^14.2.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "node-appwrite": "^27.1.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
