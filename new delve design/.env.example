# Delve platform — example environment
# Copy to .env and adjust. Never commit real secrets.

# Heroku role: traveler | api | admin (required on delve-api / delve-admin)
# DELVE_SERVICE=traveler

NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://delve:delve@localhost:5432/delve?schema=public
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Origins allowed by Backend V2 CORS
TRAVELER_WEB_URL=http://localhost:8443
ADMIN_WEB_URL=http://localhost:5174

# Brevo (transactional email) — API only. Never put these in VITE_* vars.
# Required in staging and production. Optional in local development.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@delveworldwide.me
BREVO_SENDER_NAME=Delve Worldwide

# Email verification policy (Backend V2)
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_SENDS_PER_HOUR=5

# Optional S3-compatible storage — LEGACY avatar path only. Prefer Cloudinary.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Cloudinary (user-uploaded media). API only — never put secrets in VITE_*.
# Required in staging and production. Optional in local development (uploads stay skippable).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=delve
CLOUDINARY_UPLOAD_SIGNATURE_TTL_SECONDS=300
CLOUDINARY_MAX_VIDEO_BYTES=524288000
# CLOUDINARY_WEBHOOK_SECRET=

# Optional: trust Cloudflare/Vercel geo headers for approximate city/region/country only.
# Defaults to true in staging/production, false in development unless set.
TRUST_GEO_HEADERS=false
# Throttle lastSeenAt writes (seconds). Default 300 = 5 minutes.
SESSION_LAST_SEEN_THROTTLE_SECONDS=300
SESSION_RETENTION_DAYS=90
SECURITY_EVENT_RETENTION_DAYS=365

# Administrator sessions (HttpOnly cookie — never put these secrets in VITE_*)
ADMIN_WEB_ORIGIN=http://localhost:5174
ADMIN_SESSION_COOKIE_NAME=delve_admin_session
ADMIN_CSRF_COOKIE_NAME=delve_admin_csrf
ADMIN_SESSION_TTL_HOURS=8
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=30

# Frontend-only (Vite). Never put server secrets here.
VITE_API_BASE_URL=http://localhost:4000/api/v2
# Optional public cloud name for delivery URL builder if needed client-side (not a secret).
# VITE_CLOUDINARY_CLOUD_NAME=

# Appwrite Auth (traveler). Project ID is public; never put API keys in VITE_*.
# VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
# VITE_APPWRITE_PROJECT_ID=your_project_id
# Match Console: on = require verify email before login; off = sign in immediately after register.
# VITE_APPWRITE_EMAIL_VERIFICATION=off
# Hosting deploy settings: see docs/appwrite-hosting.md
# Traveler profile collection (see docs/appwrite-traveler-profile.md)
# VITE_APPWRITE_DATABASE_ID=delve
# VITE_APPWRITE_TRAVELER_PROFILES_COLLECTION_ID=traveler_profiles
# Server-only (never VITE_*): used by `pnpm appwrite:setup-profile`
# APPWRITE_API_KEY=
