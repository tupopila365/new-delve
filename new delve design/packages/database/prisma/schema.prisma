// Delve auth + traveler profile schema (Day 2 sessions / account settings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  pending_verification
  active
  restricted
  disabled
  deactivated
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum UserRole {
  traveler
  admin
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum PostStatus {
  PUBLISHED
  DELETED
}

enum ReactionType {
  LIKE
}

enum SaveTargetType {
  POST
  LISTING
  DEAL
  EVENT
  COMMUNITY_THREAD
  JOURNEY
}

enum EventVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  GOING
  INTERESTED
}

enum NotificationType {
  NEW_FOLLOWER
  POST_LIKED
  POST_COMMENTED
  EVENT_ATTENDANCE
  EVENT_UPDATED
  EVENT_CANCELLED
  STORY_FROM_FOLLOWED
  COMMUNITY_JOIN_REQUEST
  COMMUNITY_JOIN_APPROVED
  COMMUNITY_THREAD_REPLY
  JOURNEY_LIKED
  JOURNEY_COMMENTED
  MESSAGE_RECEIVED
}

enum CommunityType {
  DESTINATION
  INTEREST
  TRANSPORT
  OFFICIAL
}

enum CommunityPrivacy {
  PUBLIC
  PRIVATE
}

enum CommunityMembershipStatus {
  JOINED
  REQUESTED
  MODERATOR
}

enum CommunityThreadKind {
  QUESTION
  DISCUSSION
}

enum JourneyVisibility {
  PUBLIC
  PRIVATE
  DRAFT
}

enum JourneyPartyType {
  SOLO
  COUPLE
  FAMILY
  GROUP
  FRIENDS
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  username           String
  usernameNormalized String        @unique
  usernameChangedAt  DateTime?
  passwordHash       String
  emailVerifiedAt    DateTime?
  accountStatus      AccountStatus @default(pending_verification)
  /// Platform role. Traveler JWT/session never grants admin API access.
  role               UserRole      @default(traveler)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  sessions                Session[]
  usernameHistory         UsernameHistory[]
  travelerProfile         TravelerProfile?
  emailChangeRequests     EmailChangeRequest[]
  notificationPreference  NotificationPreference?
  securityEvents          SecurityEvent[]
  passwordResetTokens     PasswordResetToken[]
  mediaAssets             MediaAsset[]
  mediaUploadIntents      MediaUploadIntent[]
  adminAuditLogs          AdminAuditLog[]
  posts                   Post[]
  comments                Comment[]
  reactions               Reaction[]
  saves                   Save[]
  followsOutgoing         Follow[]             @relation("FollowFollower")
  followsIncoming         Follow[]             @relation("FollowFollowing")
  travelerEvents          TravelerEvent[]
  eventAttendances        EventAttendance[]
  notifications           Notification[]
  businessMemberships     BusinessMember[]
  storySlides             StorySlide[]
  storyViewsAsViewer      StoryView[]          @relation("StoryViewer")
  storyViewsAsAuthor      StoryView[]          @relation("StoryAuthor")
  communityMemberships    CommunityMembership[]
  communityThreads        CommunityThread[]
  communityAnswers        CommunityAnswer[]
  journeys                Journey[]
  journeyComments         JourneyComment[]
  journeyReactions        JourneyReaction[]
  conversationParticipants ConversationParticipant[]
  directMessages          DirectMessage[]
  blocksOutgoing            UserBlock[]          @relation("BlockBlocker")
  blocksIncoming            UserBlock[]          @relation("BlockBlocked")

  @@index([email])
  @@index([usernameNormalized])
  @@index([role])
}

model EmailVerificationToken {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String              @unique
  expiresAt      DateTime
  usedAt         DateTime?
  deliveryStatus EmailDeliveryStatus @default(PENDING)
  createdAt      DateTime            @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

/// Authenticated device session. Token is stored hashed only — never return tokenHash to clients.
model Session {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  /// Shared across refresh rotations; reuse of a rotated token revokes the whole family.
  tokenFamilyId       String
  /// True only for sessions issued through the admin auth path.
  isAdminSession      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  lastSeenAt          DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedReason       String?
  browserName         String?
  browserMajorVersion Int?
  operatingSystem     String?
  /// desktop | phone | tablet | unknown
  deviceType          String?
  deviceLabel         String?
  approxCity          String?
  approxRegion        String?
  approxCountryCode   String?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
  @@index([tokenFamilyId])
  @@index([userId, revokedAt, expiresAt])
  @@index([userId, tokenFamilyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UsernameHistory {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usernameNormalized String
  releasedAt         DateTime
  reservedUntil      DateTime
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([usernameNormalized])
  @@index([reservedUntil])
}

model TravelerProfile {
  id                    String           @id @default(cuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String           @default("")
  bio                   String?
  /// Legacy S3/public URL — prefer avatarMedia when present. Kept for safe migration.
  avatarUrl             String?
  /// Legacy S3 object key — do not use for new uploads.
  avatarKey             String?
  avatarMediaId         String?          @unique
  avatarMedia           MediaAsset?      @relation("TravelerAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  /// Profile / dashboard banner image (Cloudinary delivery URL). Metadata only — bytes stay on Cloudinary.
  coverUrl              String?
  coverMediaId          String?          @unique
  coverMedia            MediaAsset?      @relation("TravelerCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  homeCity              String?
  homeCountryCode       String?
  preferredCurrency     String           @default("USD")
  preferredLanguage     String           @default("en")
  interests             String[]         @default([])
  /// PUBLIC profiles are searchable; PRIVATE hide from discovery (owner still sees own).
  profileVisibility     ProfileVisibility @default(PUBLIC)
  onboardingStatus      OnboardingStatus @default(NOT_STARTED)
  onboardingCompletedAt DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model EmailChangeRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model NotificationPreference {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityAccount   Boolean   @default(true)
  bookingTrip       Boolean   @default(true)
  providerMessages  Boolean   @default(true)
  communityActivity Boolean   @default(true)
  productUpdates    Boolean   @default(false)
  marketing         Boolean   @default(false)
  inApp             Boolean   @default(true)
  marketingOptInAt  DateTime?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Append-only administrator security audit trail. Never store passwords or raw tokens.
model AdminAuditLog {
  id               String   @id @default(cuid())
  actorUserId      String?
  actorUser        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorSessionId   String?
  action           String
  targetType       String?
  targetId         String?
  /// success | failure | denied
  outcome          String
  reason           String?
  metadata         Json?
  correlationId    String?
  /// One-way hash of normalized identifier for anonymous failed logins.
  identifierHash   String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
}

enum MediaStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETION_PENDING
  DELETED
}

enum MediaPurpose {
  avatar
  cover
  post
  story
  review
  business_profile
  listing
  message
}

enum MediaResourceType {
  image
  video
  raw
  auto
}

enum MediaUploadIntentStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
  CANCELLED
}

/// User-uploaded media metadata only. Never store binary, blob, or Base64 here.
/// Bytes live on Cloudinary; Browser → Cloudinary for files; Browser → Delve API → PostgreSQL for metadata.
model MediaAsset {
  id                String            @id @default(cuid())
  cloudinaryAssetId String?           @unique
  publicId          String            @unique
  version           Int?
  resourceType      MediaResourceType
  deliveryType      String            @default("upload")
  format            String?
  bytes             Int?
  width             Int?
  height            Int?
  duration          Float?
  secureUrl         String?
  status            MediaStatus       @default(PENDING)
  purpose           MediaPurpose
  altText           String?
  uploadedByUserId  String
  uploadedBy        User              @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  businessId        String?
  business          Business?         @relation("BusinessMedia", fields: [businessId], references: [id], onDelete: SetNull)
  listingId         String?
  listing           Listing?          @relation("ListingMedia", fields: [listingId], references: [id], onDelete: SetNull)
  /// Linked when purpose is post.
  postId            String?
  post              Post?             @relation(fields: [postId], references: [id], onDelete: SetNull)
  uploadIntentId    String?           @unique
  uploadIntent      MediaUploadIntent? @relation(fields: [uploadIntentId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  sortOrder         Int?
  travelerAvatarFor TravelerProfile?  @relation("TravelerAvatar")
  travelerCoverFor  TravelerProfile?  @relation("TravelerCover")
  eventCoverFor     TravelerEvent?    @relation("EventCover")
  listingCoverFor   Listing?          @relation("ListingCover")
  directMessage     DirectMessage?
  storySlide        StorySlide?

  @@index([uploadedByUserId, purpose, status])
  @@index([status])
  @@index([purpose])
  @@index([createdAt])
  @@index([businessId])
  @@index([listingId])
  @@index([postId])
  @@index([deletedAt])
}

model MediaUploadIntent {
  id                 String                   @id @default(cuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose            MediaPurpose
  expectedResourceType MediaResourceType
  maxBytes           Int
  permittedFormats   String[]
  folder             String
  businessId         String?
  listingId          String?
  originalFilename   String?
  reportedMimeType   String?
  reportedBytes      Int?
  status             MediaUploadIntentStatus  @default(PENDING)
  expiresAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime                 @default(now())
  mediaAsset         MediaAsset?

  @@index([userId, status])
  @@index([expiresAt])
  @@index([status, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

/// Ephemeral Delvers story slide (24h). See docs/delvers-stories-scope.md.
model StorySlide {
  id        String    @id @default(cuid())
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaId   String    @unique
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption   String    @default("")
  location  String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  deletedAt DateTime?

  @@index([authorId, expiresAt])
  @@index([expiresAt])
  @@index([authorId, createdAt])
  @@index([deletedAt])
}

/// Viewer has opened an author's active story set (for unseen rings).
model StoryView {
  id           String   @id @default(cuid())
  viewerId     String
  viewer       User     @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  lastViewedAt DateTime @default(now())

  @@unique([viewerId, authorId])
  @@index([authorId])
  @@index([viewerId])
}

model Post {
  id         String         @id @default(cuid())
  authorId   String
  author     User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption    String         @default("")
  location   String?
  visibility PostVisibility @default(PUBLIC)
  status     PostStatus     @default(PUBLISHED)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  media     MediaAsset[]
  reactions Reaction[]
  comments  Comment[]

  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@index([visibility])
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([userId, postId, type])
  @@index([postId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@index([authorId])
}

model Save {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType SaveTargetType
  targetId   String
  createdAt  DateTime       @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
}

model TravelerEvent {
  id            String          @id @default(cuid())
  creatorId     String
  creator       User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title         String
  description   String          @default("")
  coverUrl      String?
  coverMediaId  String?         @unique
  coverMedia    MediaAsset?     @relation("EventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  startAt       DateTime
  endAt         DateTime?
  timezone      String?
  locationName  String?
  city          String?
  country       String?
  latitude      Float?
  longitude     Float?
  category      String?
  visibility    EventVisibility @default(PUBLIC)
  status        EventStatus     @default(DRAFT)
  maxAttendees  Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  attendances EventAttendance[]

  @@index([creatorId, createdAt])
  @@index([status, startAt])
  @@index([visibility, status])
}

model EventAttendance {
  id        String           @id @default(cuid())
  eventId   String
  event     TravelerEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String           @default("")
  entityType String?
  entityId   String?
  actorId    String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum BusinessStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  CONTENT_EDITOR
}

/// Provider/business profile. Owned via BusinessMember (same User identity — no separate login).
model Business {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  logoUrl     String?
  coverUrl    String?
  email       String?
  phone       String?
  website     String?
  city        String?
  countryCode String?
  address     String?
  category    String?
  status      BusinessStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  members     BusinessMember[]
  mediaAssets MediaAsset[]     @relation("BusinessMedia")
  listings    Listing[]
  deals       Deal[]

  @@index([status])
  @@index([slug])
}

model BusinessMember {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       BusinessMemberRole
  createdAt  DateTime           @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

/// Minimal listing parent so Cloudinary listing media can attach (Day 3 media checkpoint).
model Listing {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       ListingStatus @default(DRAFT)
  coverMediaId String?       @unique
  coverMedia   MediaAsset?   @relation("ListingCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media        MediaAsset[]  @relation("ListingMedia")
  deals        Deal[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
}

enum DealDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DealStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  EXPIRED
  REJECTED
  ARCHIVED
}

/// Business deal. Stores discount inputs for Day 5 server-side price calculation (no checkout yet).
model Deal {
  id            String           @id @default(cuid())
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  discountType  DealDiscountType
  /// PERCENTAGE: 0 < value <= 100. FIXED_AMOUNT: value >= 0 in currency units.
  discountValue Decimal          @db.Decimal(12, 2)
  /// ISO currency for FIXED_AMOUNT (and Day 5 pricing). Default USD.
  currency      String           @default("USD")
  startDate     DateTime
  endDate       DateTime
  status        DealStatus       @default(DRAFT)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([businessId, status])
  @@index([listingId])
  @@index([status, startDate, endDate])
  @@index([businessId, createdAt])
}

/// Destination / interest / transport community hub.
model Community {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String           @default("")
  communityType   CommunityType
  destination     String
  topics          String[]         @default([])
  coverUrl        String?
  privacy         CommunityPrivacy @default(PUBLIC)
  official        Boolean          @default(false)
  businessManaged Boolean          @default(false)
  memberCount     Int              @default(0)
  lastActivityAt  DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  memberships CommunityMembership[]
  threads     CommunityThread[]

  @@index([communityType, destination])
  @@index([lastActivityAt])
  @@index([deletedAt])
}

model CommunityMembership {
  id          String                     @id @default(cuid())
  communityId String
  community   Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      CommunityMembershipStatus  @default(JOINED)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([communityId, userId])
  @@index([userId, createdAt])
  @@index([communityId, status])
}

/// Question or discussion inside a community.
model CommunityThread {
  id               String              @id @default(cuid())
  communityId      String
  community        Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind             CommunityThreadKind
  title            String
  body             String              @default("")
  topic            String?
  pinned           Boolean             @default(false)
  official         Boolean             @default(false)
  acceptedAnswerId String?             @unique
  acceptedAnswer   CommunityAnswer?    @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  answerCount      Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  answers CommunityAnswer[] @relation("ThreadAnswers")

  @@index([communityId, kind, createdAt])
  @@index([kind, createdAt])
  @@index([authorId, createdAt])
  @@index([deletedAt])
}

model CommunityAnswer {
  id           String          @id @default(cuid())
  threadId     String
  thread       CommunityThread @relation("ThreadAnswers", fields: [threadId], references: [id], onDelete: Cascade)
  authorId     String
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String
  helpfulCount Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  acceptedFor CommunityThread? @relation("AcceptedAnswer")

  @@index([threadId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

/// Shared traveler itinerary (Phase 1–3: list, detail, create, save).
model Journey {
  id               String            @id @default(cuid())
  slug             String            @unique
  authorId         String
  author           User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title            String
  summary          String            @default("")
  coverUrl         String?
  startPlace       String
  endPlace         String
  countries        String[]          @default([])
  durationDays     Int               @default(1)
  transportModes   String[]          @default([])
  historicalCost   String?
  currency         String            @default("N$")
  partyType        JourneyPartyType  @default(SOLO)
  tags             String[]          @default([])
  visibility       JourneyVisibility @default(PUBLIC)
  takeaway         String            @default("")
  viewCount        Int               @default(0)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  stops     JourneyStop[]
  comments  JourneyComment[]
  reactions JourneyReaction[]
  conversation Conversation?

  @@index([authorId, createdAt])
  @@index([visibility, publishedAt])
  @@index([deletedAt])
}

model JourneyComment {
  id        String    @id @default(cuid())
  journeyId String
  journey   Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([journeyId, createdAt])
  @@index([authorId])
}

model JourneyReaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, journeyId])
  @@index([journeyId])
}

model JourneyStop {
  id                       String   @id @default(cuid())
  journeyId                String
  journey                  Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sortOrder                Int
  place                    String
  region                   String   @default("")
  arrivalDay               Int      @default(1)
  durationDays             Int      @default(1)
  notes                    String   @default("")
  highlights               String[] @default([])
  mediaUrls                String[] @default([])
  transportModeToNext      String?
  transportDurationToNext  String?
  transportNotes           String?
  historicalCostHint       String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([journeyId, sortOrder])
}

enum ConversationType {
  DIRECT
  JOURNEY
}

enum DirectMessageKind {
  TEXT
  JOURNEY
  DEAL
  IMAGE
}

enum ConversationRequestStatus {
  ACCEPTED
  PENDING
  DECLINED
}

/// Traveler message thread (direct or journey group).
model Conversation {
  id              String                    @id @default(cuid())
  type            ConversationType          @default(DIRECT)
  journeyId       String?                   @unique
  journey         Journey?                  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  initiatedById   String?
  requestStatus   ConversationRequestStatus @default(ACCEPTED)
  lastMessageAt   DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([type, lastMessageAt])
  @@index([requestStatus, lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  archived       Boolean      @default(false)
  muted          Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model DirectMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind           DirectMessageKind @default(TEXT)
  body           String            @default("")
  sharedEntityId String?
  mediaId        String?           @unique
  media          MediaAsset?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}

/// Blocked travelers cannot DM each other (Phase 2).
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
