// Delve auth + traveler profile schema (Day 2 sessions / account settings).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  pending_verification
  active
  restricted
  disabled
  deactivated
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum UserRole {
  traveler
  admin
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum PostStatus {
  PUBLISHED
  DELETED
}

enum ReactionType {
  LIKE
}

enum SaveTargetType {
  POST
  LISTING
  DEAL
  EVENT
  COMMUNITY_THREAD
  JOURNEY
}

enum EventVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  GOING
  INTERESTED
}

enum NotificationType {
  NEW_FOLLOWER
  POST_LIKED
  POST_COMMENTED
  EVENT_ATTENDANCE
  EVENT_UPDATED
  EVENT_CANCELLED
  STORY_FROM_FOLLOWED
  COMMUNITY_JOIN_REQUEST
  COMMUNITY_JOIN_APPROVED
  COMMUNITY_THREAD_REPLY
  COMMUNITY_POST_APPROVED
  JOURNEY_LIKED
  JOURNEY_COMMENTED
  EVENT_LIKED
  DEAL_CLAIMED
  DEAL_CLAIM_UPDATED
  DEAL_APPROVED
  DEAL_REJECTED
  MESSAGE_RECEIVED
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_PAID
  PAYMENT_FAILED
  SETTLEMENT_ELIGIBLE
  SETTLEMENT_TRANSFERRED
  BOOKING_CANCELLATION_REQUESTED
  REFUND_PROCESSING
  REFUND_SUCCEEDED
  REFUND_FAILED
  SETTLEMENT_REVERSED
  PAYMENT_DISPUTE_OPENED
  PAYMENT_DISPUTE_WON
  PAYMENT_DISPUTE_LOST
  PAYMENT_DISPUTE_BLOCKED
  PAYMENT_DISPUTE_REVERSED
  CONTENT_REMOVED
  CONTENT_RESTORED
  CONTENT_REPORT_REVIEWED
}

enum CommunityType {
  DESTINATION
  INTEREST
  TRANSPORT
  OFFICIAL
}

enum CommunityPrivacy {
  PUBLIC
  PRIVATE
}

enum CommunityMembershipStatus {
  JOINED
  REQUESTED
  MODERATOR
  BANNED
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityThreadKind {
  POST
  QUESTION
  TIP
  DISCUSSION
  RECOMMENDATION
  ANNOUNCEMENT
  JOURNEY_SHARE
  EVENT_SHARE
}

enum CommunityThreadStatus {
  DRAFT
  PENDING
  PUBLISHED
  REMOVED
}

enum CommunityReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum CommunityInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum JourneyVisibility {
  PUBLIC
  PRIVATE
  DRAFT
}

enum JourneyPartyType {
  SOLO
  COUPLE
  FAMILY
  GROUP
  FRIENDS
}

/// Platform Admin visibility. Distinct from creator delete/cancel.
enum ContentModerationStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

enum ContentReportTargetType {
  POST
  EVENT
  JOURNEY
  POST_COMMENT
}

enum ContentReportReason {
  SPAM
  SCAM_OR_FRAUD
  HARASSMENT
  HATE_OR_ABUSE
  SEXUAL_CONTENT
  VIOLENCE_OR_THREATS
  MISLEADING_INFORMATION
  ILLEGAL_OR_DANGEROUS
  PRIVACY
  IMPERSONATION
  COMMUNITY_RULE_VIOLATION
  OTHER
}

enum ContentReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ContentModerationActionType {
  NO_ACTION
  HIDE
  REMOVE
  RESTORE
  PLATFORM_RESTRICT
}

enum AdminModerationTargetType {
  POST
  EVENT
  JOURNEY
  COMMUNITY
  COMMUNITY_THREAD
  POST_COMMENT
  COMMUNITY_COMMENT
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  username           String
  usernameNormalized String        @unique
  usernameChangedAt  DateTime?
  passwordHash       String
  emailVerifiedAt    DateTime?
  accountStatus      AccountStatus @default(pending_verification)
  /// Platform role. Traveler JWT/session never grants admin API access.
  role               UserRole      @default(traveler)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  emailVerificationTokens  EmailVerificationToken[]
  sessions                 Session[]
  usernameHistory          UsernameHistory[]
  travelerProfile          TravelerProfile?
  emailChangeRequests      EmailChangeRequest[]
  notificationPreference   NotificationPreference?
  securityEvents           SecurityEvent[]
  passwordResetTokens      PasswordResetToken[]
  mediaAssets              MediaAsset[]
  mediaUploadIntents       MediaUploadIntent[]
  mediaUploadSessions      MediaUploadSession[]
  adminAuditLogs           AdminAuditLog[]
  posts                    Post[]
  comments                 Comment[]
  reactions                Reaction[]
  saves                    Save[]
  followsOutgoing          Follow[]                        @relation("FollowFollower")
  followsIncoming          Follow[]                        @relation("FollowFollowing")
  travelerEvents           TravelerEvent[]
  eventAttendances         EventAttendance[]
  eventReactions           EventReaction[]
  notifications            Notification[]
  businessMemberships      BusinessMember[]
  storySlides              StorySlide[]
  storyViewsAsViewer       StoryView[]                     @relation("StoryViewer")
  storyViewsAsAuthor       StoryView[]                     @relation("StoryAuthor")
  communityMemberships     CommunityMembership[]
  ownedCommunities         Community[]                     @relation("CommunityOwner")
  communityReportsFiled    CommunityReport[]               @relation("CommunityReportsFiled")
  contentReportsFiled      ContentReport[]                 @relation("ContentReportsFiled")
  contentReportsReviewed   ContentReport[]                 @relation("ContentReportsReviewed")
  contentModerationActions ContentModerationAction[]
  contentAppeals           ContentAppeal[]
  communityInvitesReceived CommunityInvite[]               @relation("CommunityInvitesReceived")
  communityInvitesSent     CommunityInvite[]               @relation("CommunityInvitesSent")
  communityAuditLogs       CommunityAuditLog[]             @relation("CommunityAuditActor")
  communityThreads         CommunityThread[]
  communityThreadReactions CommunityThreadReaction[]
  communityAnswers         CommunityAnswer[]
  journeys                 Journey[]
  journeyComments          JourneyComment[]
  journeyReactions         JourneyReaction[]
  journeyEvents            JourneyEvent[]
  journeyDeals             JourneyDeal[]
  journeyPersonalisations  JourneyPersonalisation[]
  dealClaims               DealClaim[]
  bookings                 Booking[]
  payments                 Payment[]
  refunds                  Refund[]
  cancellationRequests     BookingCancellationRequest[]    @relation("CancellationRequestedBy")
  cancellationReviews      BookingCancellationRequest[]    @relation("CancellationReviewedBy")
  paymentDisputes          PaymentDispute[]
  reconciliationRuns       FinancialReconciliationRun[]
  recoveryCasesResolved    FinancialRecoveryCase[]         @relation("RecoveryResolvedBy")
  unmatchedEventsReviewed  UnmatchedStripeFinancialEvent[] @relation("UnmatchedReviewedBy")
  journeyBookings          JourneyBooking[]
  dealReportsFiled         DealReport[]                    @relation("DealReportsFiled")
  dealReportsReviewed      DealReport[]                    @relation("DealReportsReviewed")
  conversationParticipants ConversationParticipant[]
  directMessages           DirectMessage[]
  blocksOutgoing           UserBlock[]                     @relation("BlockBlocker")
  blocksIncoming           UserBlock[]                     @relation("BlockBlocked")

  @@index([email])
  @@index([usernameNormalized])
  @@index([role])
}

model EmailVerificationToken {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String              @unique
  expiresAt      DateTime
  usedAt         DateTime?
  deliveryStatus EmailDeliveryStatus @default(PENDING)
  createdAt      DateTime            @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

/// Authenticated device session. Token is stored hashed only — never return tokenHash to clients.
model Session {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  /// Shared across refresh rotations; reuse of a rotated token revokes the whole family.
  tokenFamilyId       String
  /// True only for sessions issued through the admin auth path.
  isAdminSession      Boolean   @default(false)
  createdAt           DateTime  @default(now())
  lastSeenAt          DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  revokedReason       String?
  browserName         String?
  browserMajorVersion Int?
  operatingSystem     String?
  /// desktop | phone | tablet | unknown
  deviceType          String?
  deviceLabel         String?
  approxCity          String?
  approxRegion        String?
  approxCountryCode   String?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastSeenAt])
  @@index([tokenFamilyId])
  @@index([userId, revokedAt, expiresAt])
  @@index([userId, tokenFamilyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UsernameHistory {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usernameNormalized String
  releasedAt         DateTime
  reservedUntil      DateTime
  createdAt          DateTime @default(now())

  @@index([userId])
  @@index([usernameNormalized])
  @@index([reservedUntil])
}

model TravelerProfile {
  id                    String            @id @default(cuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String            @default("")
  bio                   String?
  /// Legacy S3/public URL — prefer avatarMedia when present. Kept for safe migration.
  avatarUrl             String?
  /// Legacy S3 object key — do not use for new uploads.
  avatarKey             String?
  avatarMediaId         String?           @unique
  avatarMedia           MediaAsset?       @relation("TravelerAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  /// Profile / dashboard banner image (Cloudinary delivery URL). Metadata only — bytes stay on Cloudinary.
  coverUrl              String?
  coverMediaId          String?           @unique
  coverMedia            MediaAsset?       @relation("TravelerCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  homeCity              String?
  homeCountryCode       String?
  preferredCurrency     String            @default("USD")
  preferredLanguage     String            @default("en")
  interests             String[]          @default([])
  /// PUBLIC profiles are searchable; PRIVATE hide from discovery (owner still sees own).
  profileVisibility     ProfileVisibility @default(PUBLIC)
  onboardingStatus      OnboardingStatus  @default(NOT_STARTED)
  onboardingCompletedAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model EmailChangeRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model NotificationPreference {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  securityAccount   Boolean   @default(true)
  bookingTrip       Boolean   @default(true)
  providerMessages  Boolean   @default(true)
  communityActivity Boolean   @default(true)
  productUpdates    Boolean   @default(false)
  marketing         Boolean   @default(false)
  inApp             Boolean   @default(true)
  marketingOptInAt  DateTime?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Append-only administrator security audit trail. Never store passwords or raw tokens.
model AdminAuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actorUser      User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorSessionId String?
  action         String
  targetType     String?
  targetId       String?
  /// success | failure | denied
  outcome        String
  reason         String?
  metadata       Json?
  correlationId  String?
  /// One-way hash of normalized identifier for anonymous failed logins.
  identifierHash String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
}

enum MediaStatus {
  PENDING
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETION_PENDING
  DELETED
}

enum MediaPurpose {
  avatar
  cover
  post
  story
  review
  business_profile
  listing
  message
  event
  deal
}

enum MediaResourceType {
  image
  video
  raw
  auto
}

enum MediaUploadIntentStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
  CANCELLED
}

enum MediaUploadSessionStatus {
  PENDING
  COMPLETED
  ABANDONED
}

enum MediaModerationStatus {
  APPROVED
  PENDING
  REJECTED
  FLAGGED
}

/// User-uploaded media metadata only. Never store binary, blob, or Base64 here.
/// Bytes live on Cloudinary; Browser → Cloudinary for files; Browser → Delve API → PostgreSQL for metadata.
model MediaAsset {
  id                String                @id @default(cuid())
  cloudinaryAssetId String?               @unique
  publicId          String                @unique
  version           Int?
  resourceType      MediaResourceType
  deliveryType      String                @default("upload")
  format            String?
  bytes             Int?
  width             Int?
  height            Int?
  duration          Float?
  secureUrl         String?
  status            MediaStatus           @default(PENDING)
  moderationStatus  MediaModerationStatus @default(APPROVED)
  moderationReason  String?
  captionVttUrl     String?
  purpose           MediaPurpose
  altText           String?
  uploadedByUserId  String
  uploadedBy        User                  @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  businessId        String?
  business          Business?             @relation("BusinessMedia", fields: [businessId], references: [id], onDelete: SetNull)
  listingId         String?
  listing           Listing?              @relation("ListingMedia", fields: [listingId], references: [id], onDelete: SetNull)
  eventId           String?
  event             TravelerEvent?        @relation("EventMedia", fields: [eventId], references: [id], onDelete: SetNull)
  dealId            String?
  deal              Deal?                 @relation("DealMedia", fields: [dealId], references: [id], onDelete: SetNull)
  /// Linked when purpose is post.
  postId            String?
  post              Post?                 @relation(fields: [postId], references: [id], onDelete: SetNull)
  uploadIntentId    String?               @unique
  uploadIntent      MediaUploadIntent?    @relation(fields: [uploadIntentId], references: [id], onDelete: SetNull)
  draftId           String?
  draftSession      MediaUploadSession?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  sortOrder         Int?
  travelerAvatarFor TravelerProfile?      @relation("TravelerAvatar")
  travelerCoverFor  TravelerProfile?      @relation("TravelerCover")
  eventCoverFor     TravelerEvent?        @relation("EventCover")
  listingCoverFor   Listing?              @relation("ListingCover")
  dealCoverFor      Deal?                 @relation("DealCover")
  directMessage     DirectMessage?
  storySlide        StorySlide?

  @@index([uploadedByUserId, purpose, status])
  @@index([status])
  @@index([moderationStatus])
  @@index([purpose])
  @@index([createdAt])
  @@index([businessId])
  @@index([listingId])
  @@index([eventId])
  @@index([dealId])
  @@index([postId])
  @@index([draftId])
  @@index([deletedAt])
}

model MediaUploadSession {
  id            String                   @id @default(cuid())
  userId        String
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       MediaPurpose
  expectedCount Int                      @default(1)
  status        MediaUploadSessionStatus @default(PENDING)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  mediaAssets   MediaAsset[]
  uploadIntents MediaUploadIntent[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model MediaUploadIntent {
  id                   String                  @id @default(cuid())
  userId               String
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose              MediaPurpose
  expectedResourceType MediaResourceType
  maxBytes             Int
  permittedFormats     String[]
  folder               String
  businessId           String?
  listingId            String?
  eventId              String?
  dealId               String?
  draftId              String?
  draftSession         MediaUploadSession?     @relation(fields: [draftId], references: [id], onDelete: SetNull)
  originalFilename     String?
  reportedMimeType     String?
  reportedBytes        Int?
  status               MediaUploadIntentStatus @default(PENDING)
  expiresAt            DateTime
  completedAt          DateTime?
  createdAt            DateTime                @default(now())
  mediaAsset           MediaAsset?

  @@index([userId, status])
  @@index([expiresAt])
  @@index([status, createdAt])
  @@index([draftId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

/// Ephemeral Delvers story slide (24h). See docs/delvers-stories-scope.md.
model StorySlide {
  id        String     @id @default(cuid())
  authorId  String
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mediaId   String     @unique
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption   String     @default("")
  location  String?
  createdAt DateTime   @default(now())
  expiresAt DateTime
  deletedAt DateTime?

  @@index([authorId, expiresAt])
  @@index([expiresAt])
  @@index([authorId, createdAt])
  @@index([deletedAt])
}

/// Viewer has opened an author's active story set (for unseen rings).
model StoryView {
  id           String   @id @default(cuid())
  viewerId     String
  viewer       User     @relation("StoryViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("StoryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  lastViewedAt DateTime @default(now())

  @@unique([viewerId, authorId])
  @@index([authorId])
  @@index([viewerId])
}

model Post {
  id               String                  @id @default(cuid())
  authorId         String
  author           User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption          String                  @default("")
  location         String?
  /// Optional reference to a traveler event (Share to Delvers).
  eventId          String?
  event            TravelerEvent?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  /// Optional reference to a journey (Share to Delvers).
  journeyId        String?
  journey          Journey?                @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  visibility       PostVisibility          @default(PUBLIC)
  status           PostStatus              @default(PUBLISHED)
  /// Platform moderation. Creator delete uses status/deletedAt instead.
  moderationStatus ContentModerationStatus @default(VISIBLE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  media     MediaAsset[]
  reactions Reaction[]
  comments  Comment[]

  @@index([authorId, createdAt])
  @@index([status, createdAt])
  @@index([visibility])
  @@index([moderationStatus])
  @@index([eventId])
  @@index([journeyId])
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([userId, postId, type])
  @@index([postId])
}

model Comment {
  id               String                  @id @default(cuid())
  postId           String
  post             Post                    @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body             String
  /// Platform Admin visibility. Distinct from creator deletedAt.
  moderationStatus ContentModerationStatus @default(VISIBLE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([moderationStatus])
}

model Save {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType SaveTargetType
  targetId   String
  createdAt  DateTime       @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@index([targetType, targetId])
}

model TravelerEvent {
  id               String                  @id @default(cuid())
  creatorId        String
  creator          User                    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  description      String                  @default("")
  coverUrl         String?
  coverMediaId     String?                 @unique
  coverMedia       MediaAsset?             @relation("EventCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  startAt          DateTime
  endAt            DateTime?
  timezone         String?
  locationName     String?
  city             String?
  country          String?
  latitude         Float?
  longitude        Float?
  category         String?
  communityId      String?
  community        Community?              @relation(fields: [communityId], references: [id], onDelete: SetNull)
  businessId       String?
  business         Business?               @relation(fields: [businessId], references: [id], onDelete: SetNull)
  visibility       EventVisibility         @default(PUBLIC)
  status           EventStatus             @default(DRAFT)
  /// Platform moderation. Distinct from creator CANCELLED.
  moderationStatus ContentModerationStatus @default(VISIBLE)
  maxAttendees     Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  attendances      EventAttendance[]
  reactions        EventReaction[]
  journeyLinks     JourneyEvent[]
  sharedPosts      Post[]
  communityThreads CommunityThread[]
  media            MediaAsset[]      @relation("EventMedia")

  @@index([creatorId, createdAt])
  @@index([status, startAt])
  @@index([visibility, status])
  @@index([moderationStatus])
  @@index([communityId])
  @@index([businessId])
}

model EventReaction {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     TravelerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, eventId])
  @@index([eventId])
}

model EventAttendance {
  id        String           @id @default(cuid())
  eventId   String
  event     TravelerEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String           @default("")
  entityType String?
  entityId   String?
  actorId    String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum BusinessStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  CONTENT_EDITOR
}

/// Stripe Connect connected-account lifecycle. Having stripeAccountId is not settlement-ready.
enum StripeConnectStatus {
  NOT_CONNECTED
  ONBOARDING
  RESTRICTED
  ACTIVE
  DISABLED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundReason {
  TRAVELER_CANCELLATION
  PROVIDER_CANCELLATION
  SERVICE_UNAVAILABLE
  DUPLICATE_PAYMENT
  ADMIN_ADJUSTMENT
  OTHER
}

enum RefundActorType {
  TRAVELER
  PROVIDER
  ADMIN
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

/// Ledger status for the business share. Not a bank balance. Transfer ≠ Stripe bank payout.
enum BusinessPayableStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  TRANSFERRED
  REVERSED
  BLOCKED
  CANCELLED
}

enum TransferReversalStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum TransferReversalReason {
  BOOKING_REFUND
  DISPUTE_LOSS
}

enum PaymentDisputeStatus {
  NEEDS_RESPONSE
  UNDER_REVIEW
  WARNING
  WON
  LOST
  CLOSED
}

enum PaymentDisputeRecoveryStatus {
  NOT_REQUIRED
  BLOCKED_SETTLEMENT
  RECOVERY_PENDING
  RECOVERY_REQUIRED
  RECOVERED
  RECOVERY_FAILED
  MANUAL_REVIEW
}

enum FinancialReconciliationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum FinancialReconciliationIssueStatus {
  OPEN
  AUTO_RESOLVED
  MANUALLY_RESOLVED
  IGNORED
}

enum FinancialReconciliationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum UnmatchedFinancialEventStatus {
  OPEN
  MATCHED
  REVIEWED
}

enum FinancialRecoveryCaseStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  WRITTEN_OFF
}

/// Provider/business profile. Owned via BusinessMember (same User identity — no separate login).
model Business {
  id                          String              @id @default(cuid())
  name                        String
  slug                        String              @unique
  description                 String?
  logoUrl                     String?
  coverUrl                    String?
  email                       String?
  phone                       String?
  website                     String?
  city                        String?
  countryCode                 String?
  address                     String?
  category                    String?
  status                      BusinessStatus      @default(DRAFT)
  /// Stripe Connect connected-account id (acct_...). Not a bank account number.
  stripeAccountId             String?             @unique
  stripeAccountStatus         StripeConnectStatus @default(NOT_CONNECTED)
  stripeChargesEnabled        Boolean             @default(false)
  stripePayoutsEnabled        Boolean             @default(false)
  stripeDetailsSubmitted      Boolean             @default(false)
  stripeOnboardingCompletedAt DateTime?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  members                BusinessMember[]
  areas                  BusinessArea[]
  mediaAssets            MediaAsset[]            @relation("BusinessMedia")
  listings               Listing[]
  deals                  Deal[]
  bookings               Booking[]
  payments               Payment[]
  payables               BusinessPayable[]
  refunds                Refund[]
  transferReversals      TransferReversal[]
  paymentDisputes        PaymentDispute[]
  financialRecoveryCases FinancialRecoveryCase[]
  events                 TravelerEvent[]

  @@index([status])
  @@index([slug])
  @@index([stripeAccountStatus, updatedAt])
}

model BusinessArea {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  category    String
  description String?
  logoUrl     String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@index([businessId])
  @@index([businessId, category])
}

model BusinessMember {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       BusinessMemberRole
  createdAt  DateTime           @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

/// Minimal listing parent so Cloudinary listing media can attach (Day 3 media checkpoint).
model Listing {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessAreaId   String?
  businessArea     BusinessArea?     @relation(fields: [businessAreaId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  status           ListingStatus     @default(DRAFT)
  /// Authoritative advertised amount. Null = no monetary price (not the same as 0 = free).
  /// Future: pricing modes (starting-from, contact) can wrap this without replacing it.
  priceAmount      Decimal?          @db.Decimal(12, 2)
  /// ISO 4217 alphabetic code (NAD, USD). Required when priceAmount is set.
  currency         String?           @db.VarChar(3)
  coverMediaId     String?           @unique
  coverMedia       MediaAsset?       @relation("ListingCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media            MediaAsset[]      @relation("ListingMedia")
  deals            Deal[]
  bookings         Booking[]
  communityThreads CommunityThread[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([businessAreaId])
}

enum DealDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DealStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  EXPIRED
  REJECTED
  ARCHIVED
}

enum DealClaimMethod {
  IN_APP
  SHOW_CODE
  BOOKING_CODE
  LINK
}

enum DealClaimStatus {
  PENDING
  CONFIRMED
  REDEEMED
  CANCELLED
  EXPIRED
}

enum DealReportReason {
  SPAM
  MISLEADING
  INAPPROPRIATE
  SCAM
  OTHER
}

enum DealReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

enum DealAnalyticsKind {
  IMPRESSION
  CLICK
  CLAIM
  SAVE
  JOURNEY_ADD
  REDEEM
}

/// Business deal. Discount inputs for server-side pricing; checkout remains separate.
model Deal {
  id                 String           @id @default(cuid())
  businessId         String
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  listingId          String?
  listing            Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  discountType       DealDiscountType
  /// PERCENTAGE: 0 < value <= 100. FIXED_AMOUNT: value >= 0 in currency units.
  discountValue      Decimal          @db.Decimal(12, 2)
  /// ISO currency for FIXED_AMOUNT display. When a listing is linked, this is normalized to Listing.currency.
  currency           String           @default("USD")
  /// Frozen listing base captured at admin approve. Public/claim pricing uses this, not live Listing.priceAmount.
  publishedBasePrice Decimal?         @db.Decimal(12, 2)
  publishedCurrency  String?          @db.VarChar(3)
  startDate          DateTime
  endDate            DateTime
  status             DealStatus       @default(DRAFT)
  coverMediaId       String?          @unique
  coverMedia         MediaAsset?      @relation("DealCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  city               String?
  countryCode        String?
  category           String?
  featured           Boolean          @default(false)
  featuredRank       Int?
  claimMethod        DealClaimMethod  @default(IN_APP)
  maxClaims          Int?
  terms              String?
  eligibility        String?
  included           String?
  excluded           String?
  viewCount          Int              @default(0)
  claimCount         Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  media     MediaAsset[]         @relation("DealMedia")
  journeys  JourneyDeal[]
  claims    DealClaim[]
  bookings  Booking[]
  reports   DealReport[]
  analytics DealAnalyticsEvent[]

  @@index([businessId, status])
  @@index([listingId])
  @@index([status, startDate, endDate])
  @@index([businessId, createdAt])
  @@index([status, featured, endDate])
  @@index([city])
  @@index([category])
  @@index([featured, featuredRank])
}

model JourneyDeal {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  addedById String
  addedBy   User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([journeyId, dealId])
  @@index([dealId])
  @@index([addedById])
}

model JourneyBooking {
  id        String   @id @default(cuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addedById String
  addedBy   User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([journeyId, bookingId])
  @@index([bookingId])
  @@index([addedById])
}

model DealClaim {
  id                             String           @id @default(cuid())
  dealId                         String
  deal                           Deal             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  userId                         String
  user                           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                         DealClaimStatus  @default(PENDING)
  code                           String
  note                           String?
  /// Snapshot of commercial terms at claim time. Later Deal edits must not rewrite this.
  titleSnapshot                  String
  discountTypeSnapshot           DealDiscountType
  discountValueSnapshot          Decimal          @db.Decimal(12, 2)
  currencySnapshot               String
  /// Optional list/deal prices — null until checkout pricing exists. Never invent amounts.
  originalPriceSnapshot          Decimal?         @db.Decimal(12, 2)
  dealPriceSnapshot              Decimal?         @db.Decimal(12, 2)
  discountSummarySnapshot        String
  termsSnapshot                  String?
  eligibilitySnapshot            String?
  includedSnapshot               String?
  excludedSnapshot               String?
  redemptionInstructionsSnapshot String?
  expiresAt                      DateTime
  redeemedAt                     DateTime?
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt
  bookings                       Booking[]

  @@unique([userId, dealId])
  @@unique([code])
  @@index([dealId, status])
  @@index([userId, createdAt])
  @@index([expiresAt, status])
}

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

/// Traveler reservation against a Listing. Prices are snapshotted at create; payments are a later domain.
model Booking {
  id                      String        @id @default(cuid())
  bookingReference        String        @unique
  userId                  String
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId              String
  business                Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  listingId               String
  listing                 Listing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  dealId                  String?
  deal                    Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealClaimId             String?
  dealClaim               DealClaim?    @relation(fields: [dealClaimId], references: [id], onDelete: SetNull)
  status                  BookingStatus @default(PENDING)
  startDateTime           DateTime?
  endDateTime             DateTime?
  quantity                Int           @default(1)
  guestCount              Int?
  customerNote            String?
  originalAmount          Decimal       @db.Decimal(12, 2)
  discountAmount          Decimal       @db.Decimal(12, 2)
  finalAmount             Decimal       @db.Decimal(12, 2)
  currency                String        @db.VarChar(3)
  listingTitleSnapshot    String
  dealTitleSnapshot       String?
  discountSummarySnapshot String?
  cancelReason            String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  confirmedAt             DateTime?
  cancelledAt             DateTime?
  completedAt             DateTime?

  journeys               JourneyBooking[]
  payments               Payment[]
  payable                BusinessPayable?
  refunds                Refund[]
  cancellationRequests   BookingCancellationRequest[]
  transferReversals      TransferReversal[]
  paymentDisputes        PaymentDispute[]
  financialRecoveryCases FinancialRecoveryCase[]

  @@index([userId, createdAt])
  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([listingId])
  @@index([dealId])
  @@index([dealClaimId])
  @@index([status, createdAt])
  @@index([bookingReference])
}

/// Traveler collection attempt against a Booking. Amounts come from the Booking snapshot, never the client.
model Payment {
  id                         String                  @id @default(cuid())
  bookingId                  String
  booking                    Booking                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  userId                     String
  user                       User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessId                 String
  business                   Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  provider                   PaymentProvider         @default(STRIPE)
  stripePaymentIntentId      String?                 @unique
  stripeCheckoutSessionId    String?                 @unique
  stripeChargeId             String?
  status                     PaymentStatus           @default(PENDING)
  amount                     Decimal                 @db.Decimal(12, 2)
  currency                   String                  @db.VarChar(3)
  idempotencyKey             String                  @unique
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  processingAt               DateTime?
  paidAt                     DateTime?
  failedAt                   DateTime?
  cancelledAt                DateTime?
  failureCode                String?
  failureMessage             String?
  stripeFeeAmount            Decimal?                @db.Decimal(12, 2)
  stripeBalanceTransactionId String?
  payable                    BusinessPayable?
  refunds                    Refund[]
  transferReversals          TransferReversal[]
  paymentDisputes            PaymentDispute[]
  financialRecoveryCases     FinancialRecoveryCase[]

  @@index([bookingId, status])
  @@index([userId, createdAt])
  @@index([businessId, status])
  @@index([stripeChargeId])
  @@index([status, updatedAt])
  @@index([status, paidAt])
}

/// Business share of a successful collection. Database amounts are payables, not bank funds.
model BusinessPayable {
  id                       String                  @id @default(cuid())
  bookingId                String                  @unique
  booking                  Booking                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentId                String                  @unique
  payment                  Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  businessId               String
  business                 Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  status                   BusinessPayableStatus   @default(PENDING)
  grossAmount              Decimal                 @db.Decimal(12, 2)
  platformCommissionAmount Decimal                 @db.Decimal(12, 2)
  businessNetAmount        Decimal                 @db.Decimal(12, 2)
  currency                 String                  @db.VarChar(3)
  /// Actual Stripe processing fee when known. Null means not retrieved — never a guessed fee.
  stripeFeeAmount          Decimal?                @db.Decimal(12, 2)
  stripeTransferId         String?                 @unique
  transferGroup            String
  eligibilityCode          String?
  lastFailureCode          String?
  lastFailureMessage       String?
  eligibleAt               DateTime?
  processingAt             DateTime?
  transferredAt            DateTime?
  blockedAt                DateTime?
  cancelledAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  attempts                 SettlementAttempt[]
  transferReversal         TransferReversal?
  financialRecoveryCases   FinancialRecoveryCase[]

  @@index([businessId, status])
  @@index([businessId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, transferredAt])
}

/// One Stripe Transfer attempt against a payable. Does not represent a bank payout.
model SettlementAttempt {
  id               String          @id @default(cuid())
  payableId        String
  payable          BusinessPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)
  outcome          String
  stripeTransferId String?
  failureCode      String?
  failureMessage   String?
  actorUserId      String?
  createdAt        DateTime        @default(now())

  @@index([payableId, createdAt])
}

/// Idempotent Stripe (or other provider) webhook receipts.
model PaymentWebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  eventType       String
  processedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@unique([provider, providerEventId])
  @@index([createdAt])
}

/// Traveler/provider asked to cancel; not the same as Booking CANCELLED.
model BookingCancellationRequest {
  id                String                    @id @default(cuid())
  bookingId         String
  booking           Booking                   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  requestedByUserId String
  requestedBy       User                      @relation("CancellationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  requestedByType   RefundActorType
  reason            RefundReason
  note              String?
  status            CancellationRequestStatus @default(PENDING)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  reviewedAt        DateTime?
  reviewedByUserId  String?
  reviewedBy        User?                     @relation("CancellationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  refunds           Refund[]

  @@index([bookingId, status])
  @@index([status, createdAt])
}

/// Money returned to the traveler. Independent of Payment.status.
model Refund {
  id                     String                      @id @default(cuid())
  paymentId              String
  payment                Payment                     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookingId              String
  booking                Booking                     @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  userId                 String
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessId             String
  business               Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cancellationRequestId  String?
  cancellationRequest    BookingCancellationRequest? @relation(fields: [cancellationRequestId], references: [id], onDelete: SetNull)
  provider               PaymentProvider             @default(STRIPE)
  stripeRefundId         String?                     @unique
  status                 RefundStatus                @default(PENDING)
  amount                 Decimal                     @db.Decimal(12, 2)
  currency               String                      @db.VarChar(3)
  reason                 RefundReason
  explanation            String?
  requestedByType        RefundActorType
  requestedByUserId      String?
  idempotencyKey         String                      @unique
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  processingAt           DateTime?
  succeededAt            DateTime?
  failedAt               DateTime?
  cancelledAt            DateTime?
  failureCode            String?
  failureMessage         String?
  transferReversals      TransferReversal[]
  financialRecoveryCases FinancialRecoveryCase[]

  @@index([paymentId, status])
  @@index([bookingId, status])
  @@index([businessId, status])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, succeededAt])
}

/// Recovers a Stripe Transfer to a connected account. Not a bank payout reversal.
model TransferReversal {
  id                       String                  @id @default(cuid())
  businessPayableId        String                  @unique
  businessPayable          BusinessPayable         @relation(fields: [businessPayableId], references: [id], onDelete: Restrict)
  paymentId                String
  payment                  Payment                 @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookingId                String
  booking                  Booking                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refundId                 String?
  refund                   Refund?                 @relation(fields: [refundId], references: [id], onDelete: SetNull)
  businessId               String
  business                 Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  stripeTransferId         String
  stripeTransferReversalId String?                 @unique
  status                   TransferReversalStatus  @default(PENDING)
  amount                   Decimal                 @db.Decimal(12, 2)
  currency                 String                  @db.VarChar(3)
  reason                   TransferReversalReason  @default(BOOKING_REFUND)
  idempotencyKey           String                  @unique
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  processingAt             DateTime?
  succeededAt              DateTime?
  failedAt                 DateTime?
  failureCode              String?
  failureMessage           String?
  financialRecoveryCases   FinancialRecoveryCase[]

  @@index([paymentId, status])
  @@index([bookingId, status])
  @@index([refundId])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([status, succeededAt])
}

/// Cardholder/network challenge of a collected Payment. Separate from Refund and Payment.status.
model PaymentDispute {
  id                     String                       @id @default(cuid())
  paymentId              String
  payment                Payment                      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookingId              String
  booking                Booking                      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  businessId             String
  business               Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId                 String
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider               PaymentProvider              @default(STRIPE)
  stripeDisputeId        String                       @unique
  stripeChargeId         String?
  stripePaymentIntentId  String?
  status                 PaymentDisputeStatus         @default(NEEDS_RESPONSE)
  stripeStatus           String
  amount                 Decimal                      @db.Decimal(12, 2)
  currency               String                       @db.VarChar(3)
  reason                 String
  isChargeRefundable     Boolean?
  evidenceDueAt          DateTime?
  needsResponseAt        DateTime?
  submittedAt            DateTime?
  closedAt               DateTime?
  wonAt                  DateTime?
  lostAt                 DateTime?
  lastStripeEventAt      DateTime?
  lastStripeEventCreated Int?
  recoveryStatus         PaymentDisputeRecoveryStatus @default(NOT_REQUIRED)
  exposureCode           String?
  providerEvidenceNote   String?
  providerEvidenceAt     DateTime?
  providerEvidenceById   String?
  stripeFeeAmount        Decimal?                     @db.Decimal(12, 2)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  financialRecoveryCases FinancialRecoveryCase[]

  @@index([paymentId, status])
  @@index([bookingId])
  @@index([businessId, status])
  @@index([status, createdAt])
  @@index([recoveryStatus])
  @@index([status, updatedAt])
}

model UnmatchedStripeFinancialEvent {
  id              String                        @id @default(cuid())
  providerEventId String                        @unique
  eventType       String
  stripeObjectId  String?
  chargeId        String?
  paymentIntentId String?
  note            String
  status          UnmatchedFinancialEventStatus @default(OPEN)
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?                         @relation("UnmatchedReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
}

model FinancialReconciliationRun {
  id                String                           @id @default(cuid())
  scope             String
  status            FinancialReconciliationRunStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  recordsChecked    Int                              @default(0)
  mismatchesFound   Int                              @default(0)
  recoveriesApplied Int                              @default(0)
  errorsCount       Int                              @default(0)
  triggeredByType   String
  triggeredByUserId String?
  triggeredBy       User?                            @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime                         @default(now())
  issues            FinancialReconciliationIssue[]

  @@index([status, createdAt])
  @@index([createdAt])
}

model FinancialReconciliationIssue {
  id                 String                             @id @default(cuid())
  fingerprint        String                             @unique
  runId              String?
  run                FinancialReconciliationRun?        @relation(fields: [runId], references: [id], onDelete: SetNull)
  type               String
  severity           FinancialReconciliationSeverity
  status             FinancialReconciliationIssueStatus @default(OPEN)
  paymentId          String?
  bookingId          String?
  businessId         String?
  businessPayableId  String?
  refundId           String?
  transferReversalId String?
  disputeId          String?
  stripeObjectType   String?
  stripeObjectId     String?
  code               String
  summary            String
  recommendedAction  String?
  localState         String?
  stripeState        String?
  detectedAt         DateTime                           @default(now())
  lastDetectedAt     DateTime                           @default(now())
  resolvedAt         DateTime?
  resolutionType     String?
  resolutionNote     String?

  @@index([status, severity, detectedAt])
  @@index([type, status])
  @@index([businessId, status])
  @@index([bookingId])
  @@index([paymentId, status, severity])
  @@index([code, status])
}

model FinancialRecoveryCase {
  id                 String                      @id @default(cuid())
  fingerprint        String                      @unique
  businessId         String
  business           Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentId          String?
  payment            Payment?                    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookingId          String?
  booking            Booking?                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  businessPayableId  String?
  businessPayable    BusinessPayable?            @relation(fields: [businessPayableId], references: [id], onDelete: Restrict)
  disputeId          String?
  dispute            PaymentDispute?             @relation(fields: [disputeId], references: [id], onDelete: Restrict)
  transferReversalId String?
  transferReversal   TransferReversal?           @relation(fields: [transferReversalId], references: [id], onDelete: Restrict)
  type               String
  status             FinancialRecoveryCaseStatus @default(OPEN)
  amount             Decimal                     @db.Decimal(12, 2)
  currency           String                      @db.VarChar(3)
  reason             String
  adminNote          String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedBy         User?                       @relation("RecoveryResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  refund             Refund?                     @relation(fields: [refundId], references: [id])
  refundId           String?

  @@index([businessId, status])
  @@index([status, createdAt])
  @@index([paymentId])
  @@index([disputeId])
}

model DealReport {
  id           String           @id @default(cuid())
  dealId       String
  deal         Deal             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  reporterId   String
  reporter     User             @relation("DealReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       DealReportReason
  details      String?
  status       DealReportStatus @default(OPEN)
  reviewedById String?
  reviewedBy   User?            @relation("DealReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  resolution   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([reporterId, dealId])
  @@index([dealId])
  @@index([status, createdAt])
}

model DealAnalyticsEvent {
  id        String            @id @default(cuid())
  dealId    String
  deal      Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?
  kind      DealAnalyticsKind
  createdAt DateTime          @default(now())

  @@index([dealId, kind, createdAt])
  @@index([createdAt])
}

/// Destination / interest / transport community hub.
model Community {
  id                         String                  @id @default(cuid())
  slug                       String                  @unique
  name                       String
  description                String                  @default("")
  about                      String                  @default("")
  communityType              CommunityType
  category                   String                  @default("OTHER")
  destination                String
  city                       String?
  country                    String?
  isGlobal                   Boolean                 @default(true)
  topics                     String[]                @default([])
  avatarUrl                  String?
  coverUrl                   String?
  privacy                    CommunityPrivacy        @default(PUBLIC)
  requireJoinApproval        Boolean                 @default(false)
  requireRuleAcknowledgement Boolean                 @default(false)
  requirePostApproval        Boolean                 @default(false)
  postingPermission          String                  @default("MEMBERS")
  official                   Boolean                 @default(false)
  businessManaged            Boolean                 @default(false)
  ownerUserId                String?
  owner                      User?                   @relation("CommunityOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  memberCount                Int                     @default(0)
  lastActivityAt             DateTime                @default(now())
  /// Platform restriction. Distinct from owner deletedAt.
  moderationStatus           ContentModerationStatus @default(VISIBLE)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  deletedAt                  DateTime?

  memberships  CommunityMembership[]
  threads      CommunityThread[]
  events       TravelerEvent[]
  rules        CommunityRule[]
  reports      CommunityReport[]
  invites      CommunityInvite[]
  auditLogs    CommunityAuditLog[]
  conversation Conversation?

  @@index([communityType, destination])
  @@index([category, city, country])
  @@index([lastActivityAt])
  @@index([deletedAt])
  @@index([moderationStatus])
  @@index([ownerUserId])
}

model CommunityRule {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reports CommunityReport[]

  @@index([communityId, sortOrder])
}

model CommunityReport {
  id          String                @id @default(cuid())
  communityId String
  community   Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User                  @relation("CommunityReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType  String
  targetId    String
  ruleId      String?
  rule        CommunityRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  reason      String
  description String?
  status      CommunityReportStatus @default(OPEN)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([communityId, status, createdAt])
  @@index([targetType, targetId])
}

/// Traveler reports against Delvers posts, events, journeys, and post comments.
/// Community thread/answer reports stay on CommunityReport.
/// Open-report uniqueness is a partial unique index (see migration), not a lifetime unique.
model ContentReport {
  id                   String                  @id @default(cuid())
  reporterId           String
  reporter             User                    @relation("ContentReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType           ContentReportTargetType
  targetId             String
  reason               ContentReportReason
  details              String?
  /// Text/title as seen at report time. Media assets are not copied.
  reportedTextSnapshot String?
  status               ContentReportStatus     @default(OPEN)
  reviewedAt           DateTime?
  reviewedByAdminId    String?
  reviewedBy           User?                   @relation("ContentReportsReviewed", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  resolution           String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
  @@index([reporterId, targetType, targetId, status])
}

model ContentModerationAction {
  id          String                      @id @default(cuid())
  targetType  AdminModerationTargetType
  targetId    String
  action      ContentModerationActionType
  reason      ContentReportReason?
  note        String?
  actorUserId String
  actor       User                        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime                    @default(now())
  appeals     ContentAppeal[]

  @@index([targetType, targetId, createdAt])
  @@index([actorUserId, createdAt])
}

/// Future Content Appeal domain. Distinct from ContentReport. No traveler submission UI in Phase 5.
enum ContentAppealStatus {
  OPEN
  UNDER_REVIEW
  UPHELD
  OVERTURNED
  WITHDRAWN
}

model ContentAppeal {
  id                 String                    @id @default(cuid())
  moderationActionId String
  moderationAction   ContentModerationAction   @relation(fields: [moderationActionId], references: [id], onDelete: Restrict)
  appellantUserId    String
  appellant          User                      @relation(fields: [appellantUserId], references: [id], onDelete: Cascade)
  targetType         AdminModerationTargetType
  targetId           String
  statement          String?
  status             ContentAppealStatus       @default(OPEN)
  reviewedAt         DateTime?
  reviewedByAdminId  String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([moderationActionId])
  @@index([targetType, targetId])
  @@index([appellantUserId, createdAt])
}

model CommunityInvite {
  id            String                @id @default(cuid())
  communityId   String
  community     Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  invitedUserId String
  invitedUser   User                  @relation("CommunityInvitesReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedById   String
  invitedBy     User                  @relation("CommunityInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  status        CommunityInviteStatus @default(PENDING)
  expiresAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([communityId, invitedUserId])
  @@index([invitedUserId, status])
}

model CommunityAuditLog {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation("CommunityAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([communityId, createdAt])
}

model CommunityMembership {
  id          String                    @id @default(cuid())
  communityId String
  community   Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      CommunityMembershipStatus @default(JOINED)
  role        CommunityMemberRole       @default(MEMBER)
  mutedUntil  DateTime?
  banReason   String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@unique([communityId, userId])
  @@index([userId, createdAt])
  @@index([communityId, status])
  @@index([communityId, role])
}

/// Question or discussion inside a community.
model CommunityThread {
  id               String                @id @default(cuid())
  communityId      String
  community        Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind             CommunityThreadKind
  status           CommunityThreadStatus @default(PUBLISHED)
  title            String
  body             String                @default("")
  topic            String?
  locationName     String?
  mediaUrls        String[]              @default([])
  journeyId        String?
  journey          Journey?              @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  eventId          String?
  event            TravelerEvent?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  listingId        String?
  listing          Listing?              @relation(fields: [listingId], references: [id], onDelete: SetNull)
  pinned           Boolean               @default(false)
  official         Boolean               @default(false)
  answered         Boolean               @default(false)
  acceptedAnswerId String?               @unique
  acceptedAnswer   CommunityAnswer?      @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id], onDelete: SetNull)
  answerCount      Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  answers   CommunityAnswer[]         @relation("ThreadAnswers")
  reactions CommunityThreadReaction[]

  @@index([communityId, kind, createdAt])
  @@index([communityId, status, pinned, createdAt])
  @@index([kind, createdAt])
  @@index([authorId, createdAt])
  @@index([deletedAt])
}

model CommunityAnswer {
  id               String                  @id @default(cuid())
  threadId         String
  thread           CommunityThread         @relation("ThreadAnswers", fields: [threadId], references: [id], onDelete: Cascade)
  authorId         String
  author           User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body             String
  helpfulCount     Int                     @default(0)
  /// Platform Admin visibility. Distinct from creator deletedAt.
  moderationStatus ContentModerationStatus @default(VISIBLE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  acceptedFor CommunityThread? @relation("AcceptedAnswer")

  @@index([threadId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
  @@index([moderationStatus])
}

model CommunityThreadReaction {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([userId, threadId])
  @@index([threadId])
}

/// Shared traveler itinerary (Phase 1–3: list, detail, create, save).
model Journey {
  id                String                  @id @default(cuid())
  slug              String                  @unique
  authorId          String
  author            User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title             String
  summary           String                  @default("")
  coverUrl          String?
  coverResourceType String?
  startDate         DateTime?
  endDate           DateTime?
  startPlace        String
  endPlace          String
  countries         String[]                @default([])
  durationDays      Int                     @default(1)
  transportModes    String[]                @default([])
  historicalCost    String?
  currency          String                  @default("N$")
  partyType         JourneyPartyType        @default(SOLO)
  tags              String[]                @default([])
  visibility        JourneyVisibility       @default(PUBLIC)
  /// Platform moderation. Distinct from author deletedAt.
  moderationStatus  ContentModerationStatus @default(VISIBLE)
  takeaway          String                  @default("")
  viewCount         Int                     @default(0)
  publishedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  stops            JourneyStop[]
  comments         JourneyComment[]
  reactions        JourneyReaction[]
  events           JourneyEvent[]
  deals            JourneyDeal[]
  bookings         JourneyBooking[]
  conversation     Conversation?
  sharedPosts      Post[]
  communityThreads CommunityThread[]
  personalisations JourneyPersonalisation[]

  @@index([authorId, createdAt])
  @@index([visibility, publishedAt])
  @@index([moderationStatus])
  @@index([deletedAt])
}

/// Per-user personalisation layer for journeys the user has authored or saved.
/// Stores private custom title, personal notes, and display sort order.
/// Never exposed to other users — owner-only read/write via authenticated API.
model JourneyPersonalisation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeyId   String
  journey     Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  customTitle String?  @db.VarChar(200)
  notes       String?  @db.VarChar(4000)
  /// Lower = shown first in My Journeys list. Null = no custom order (use createdAt).
  sortOrder   Int?
  updatedAt   DateTime @updatedAt

  @@unique([userId, journeyId])
  @@index([userId, sortOrder])
  @@index([journeyId])
}

/// Reference link: event added to a journey (does not duplicate event data).
model JourneyEvent {
  id        String        @id @default(cuid())
  journeyId String
  journey   Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  eventId   String
  event     TravelerEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  addedById String
  addedBy   User          @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([journeyId, eventId])
  @@index([eventId])
  @@index([addedById])
}

model JourneyComment {
  id        String    @id @default(cuid())
  journeyId String
  journey   Journey   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([journeyId, createdAt])
  @@index([authorId])
}

model JourneyReaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, journeyId])
  @@index([journeyId])
}

model JourneyStop {
  id                      String   @id @default(cuid())
  journeyId               String
  journey                 Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  sortOrder               Int
  place                   String
  region                  String   @default("")
  arrivalDay              Int      @default(1)
  durationDays            Int      @default(1)
  notes                   String   @default("")
  highlights              String[] @default([])
  mediaUrls               String[] @default([])
  /// Parallel to mediaUrls: "image" | "video" per item (same length when set).
  mediaResourceTypes      String[] @default([])
  transportModeToNext     String?
  transportDurationToNext String?
  transportNotes          String?
  historicalCostHint      String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([journeyId, sortOrder])
}

enum ConversationType {
  DIRECT
  JOURNEY
  COMMUNITY
}

enum DirectMessageKind {
  TEXT
  JOURNEY
  DEAL
  IMAGE
}

enum ConversationRequestStatus {
  ACCEPTED
  PENDING
  DECLINED
}

/// Traveler message thread (direct, journey, or community group).
model Conversation {
  id            String                    @id @default(cuid())
  type          ConversationType          @default(DIRECT)
  journeyId     String?                   @unique
  journey       Journey?                  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  communityId   String?                   @unique
  community     Community?                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  initiatedById String?
  requestStatus ConversationRequestStatus @default(ACCEPTED)
  lastMessageAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]

  @@index([type, lastMessageAt])
  @@index([requestStatus, lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  archived       Boolean      @default(false)
  muted          Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model DirectMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind           DirectMessageKind @default(TEXT)
  body           String            @default("")
  sharedEntityId String?
  mediaId        String?           @unique
  media          MediaAsset?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}

/// Blocked travelers cannot DM each other (Phase 2).
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
