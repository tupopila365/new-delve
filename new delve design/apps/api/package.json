{
  "name": "@delve/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:auth": "vitest run",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:seed:marketing-deals": "tsx scripts/seed-marketing-deals.ts",
    "db:seed:marketing-deals:cleanup": "tsx scripts/seed-marketing-deals.ts --cleanup"
  },
  "dependencies": {
    "@delve/config": "workspace:*",
    "@delve/contracts": "workspace:*",
    "@delve/database": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jose": "^6.2.8",
    "morgan": "^1.10.0",
    "stripe": "^18.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.5"
  }
}
